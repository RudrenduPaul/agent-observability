{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.RudrenduPaul/agent-observability",
  "description": "AI agent observability with deterministic record/replay for debugging agent failures.",
  "repository": {
    "url": "https://github.com/RudrenduPaul/agent-observability",
    "source": "github"
  },
  "version": "0.1.11",
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "agent-observability-trace-cli",
      "version": "0.1.11",
      "runtimeHint": "uvx",
      "runtimeArguments": [
        {
          "type": "named",
          "name": "--from",
          "value": "agent-observability-trace-cli"
        }
      ],
      "packageArguments": [
        {
          "type": "positional",
          "valueHint": "script_name",
          "value": "agent-trace-mcp"
        }
      ],
      "transport": {
        "type": "stdio"
      }
    }
  ]
}
